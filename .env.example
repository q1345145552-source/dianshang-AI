# ============================================================
# 电商作图平台 - 环境变量模板
#
# 这个文件是模板，不是拿来直接用的配置。
# 三套环境各有自己的一份：
#     开发：.env.dev
#     测试：.env.test
#     线上：.env.prod
# make up 发现缺哪份就自动从本文件复制一份出来。
#
# 下面填的都是本地开发的占位值，不含任何真实系统的凭据。
# 测试和线上环境必须换成真实值，并且不要把 .env.test / .env.prod 提交到仓库。
# ============================================================

# 环境标识，用来在日志里区分是哪个环境
APP_ENV=development

# ---- 数据库 PostgreSQL ----
PGUSER=dianshangzuotu
PGPASSWORD=local_dev_placeholder
PGDATABASE=dianshangzuotu
POSTGRES_PORT=5434

# ---- 队列 Redis ----
REDIS_PASSWORD=
REDIS_PORT=6380
WORKER_QUEUE=default

# ---- 文件存储 MinIO ----
MINIO_ACCESS_KEY=localdevaccess
MINIO_SECRET_KEY=localdevsecret
MINIO_BUCKET=assets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 应用端口 ----
# 本机已经有别的项目占了 3001、5432、6379，所以这里错开用。
# 换机器如果没冲突，改回 3001 / 5432 / 6379 也可以。
WEB_PORT=3000
API_PORT=3002
